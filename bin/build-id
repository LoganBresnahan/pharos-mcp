#!/bin/sh
# Write <release>/BUILD_ID (ADR-034): the first 16 hex digits of a
# SHA-256 over every file of the assembled release (ERTS, lib/,
# releases/) and the shim binary, so a rebuild that changes any byte
# never joins a daemon running other code.
#
#   bin/build-id <release-root> <shim-binary>
#
# Paths are hashed relative to the release root together with each
# file's digest, so moving the release does not change its id.
set -eu
root=$1
[ -d "$root/releases" ] || { echo "build-id: $root is not a release" >&2; exit 1; }
[ -f "$2" ] || { echo "build-id: no shim at $2" >&2; exit 1; }
shim=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")

if command -v sha256sum >/dev/null 2>&1; then
  sha() { sha256sum "$@"; }
else
  sha() { shasum -a 256 "$@"; }
fi

id=$(
  {
    cd "$root"
    find erts-* lib releases -type f ! -name BUILD_ID | LC_ALL=C sort | while IFS= read -r f; do
      sha "$f"
    done
    printf 'shim  '
    sha < "$shim"
  } | sha | cut -c1-16
)
printf '%s\n' "$id" > "$root/BUILD_ID"
printf '%s\n' "$id"
